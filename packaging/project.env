# Per-project parameters for the vendored standard scripts. Not vendored, outside the drift lock.
PROJECT_REPO_SLUG="SisyphusMD/appliance-job-monitor"
# A YAML blueprint repo takes only the release and hygiene helpers; the Python and packaging tooling
# has nothing to act on here.
STANDARD_FILES=".editorconfig .github/PULL_REQUEST_TEMPLATE.md packaging/changelog-section.sh packaging/check-doc-links.py packaging/check-gitignore-base.py packaging/check-standard-sync.py packaging/forgejo-release.sh packaging/github-release.sh packaging/gitignore.base packaging/next-version.sh packaging/promote-changelog.sh packaging/push-tag.sh packaging/reconcile-releases.sh packaging/release-common.sh packaging/revendor-standard.sh packaging/shellcheck-all.sh"
